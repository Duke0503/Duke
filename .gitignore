# dependencies
node_modules/
.pnpm-store/

# builds
dist/
.next/
out/
build/
*.tsbuildinfo
# regenerated by Next on every build
next-env.d.ts

# drizzle-kit `generate` output. Duke creates its tables with `db:push`, which reads the schema
# file and writes nothing here, so this folder only appears if someone runs the migration
# workflow by hand. It should never be committed.
packages/adapters/drizzle/

# env (never commit secrets)
.env
.env.local
.env.*.local

# runtime logs (daily files + gzipped archive)
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# tests
coverage/

# local tooling: 9router-go gateway (cloned source + release binary + sqlite data).
# Not Duke source, and it carries provider credentials in its own DB.
.9router-go/

# agent tooling (installed skills, not project source)
.claude/
.agents/
# local BMad overrides (username, editor) — per-machine, never shared
_bmad/config.user.toml

# os
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/*
!.vscode/extensions.json
