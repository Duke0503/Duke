# Copy to .env and fill in the blanks. Never commit .env.
#
# Only the empty values need you. Every line with a value already works as-is.
# When you have pasted the keys, start the API and read the first log line: it either says
# everything is set, or names exactly which key is still missing.

# --- how it runs ---
NODE_ENV=development
LOG_LEVEL=debug
# Folder for the daily log files. Ignored by git. On the VPS point this at a mounted volume.
# Duke writes two files per day:
#   logs/all/<service>.<date>.log     every line, the full story of the day
#   logs/error/<service>.<date>.log   errors only, the short file you open when something breaks
# Finished days are gzipped into logs/archive/ and pruned after LOG_RETENTION_DAYS.
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# --- LiveKit Cloud (the phone line) ---
# Carries the live audio between the phone and the agent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Name the agent worker registers under. The API tells LiveKit to send each new room to it.
LIVEKIT_AGENT_NAME=duke
# How long a join token stays valid, in seconds. A call screen refreshes past this.
LIVEKIT_TOKEN_TTL=900

# --- STT: the ears (Deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- LLM: the brain (Groq) ---
# Free, and fast enough to feel like a real conversation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- TTS: the voice (Azure Speech, free F0 tier) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# The default voice, used when a friend has no voice of their own.
AZURE_VOICE=en-US-AriaNeural

# --- Data ---
# Supabase Postgres. Use the pooled connection string (port 6543) in production.
DATABASE_URL=postgresql://duke:duke@localhost:5432/duke
# Upstash Redis uses a rediss:// URL. A local Docker Redis uses redis://localhost:6379.
# This holds the per-call brief and the monthly usage counters.
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3001
# The browser origin allowed to call the API (CORS).
WEB_ORIGIN=http://localhost:3000

# --- Web ---
# Where the Next server forwards /api/* to. Read by the Next server, NOT sent to the browser,
# so it does not need the NEXT_PUBLIC_ prefix. Leave it for local development; in Docker set it
# to the API service, e.g. http://api:3001.
# API_ORIGIN=http://127.0.0.1:3001
