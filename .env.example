# Copy to .env and fill in. Never commit .env.

# --- how it runs ---
NODE_ENV=development
LOG_LEVEL=debug
# Folder for the daily log files. Ignored by git. On the VPS point this at a mounted volume.
LOG_DIR=logs
# Gzipped archives older than this many days are deleted.
LOG_RETENTION_DAYS=14

# --- LiveKit Cloud (the phone line) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT: ears ---
DEEPGRAM_API_KEY=

# --- LLM: brain ---
GROQ_API_KEY=

# --- TTS: voice ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Data ---
DATABASE_URL=postgresql://duke:duke@localhost:5432/duke
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- API ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
