# Copy to .env and fill in the blanks. Never commit .env.
#
# Only the empty values need you. Every line with a value already works as-is.
# When you have pasted the keys, start the API and read the first log line: it either says
# everything is set, or names exactly which key is still missing.

# --- how it runs ---
NODE_ENV=development
LOG_LEVEL=debug
# Folder for the daily log files. Ignored by git. On the VPS point this at a mounted volume.
# Duke writes two files per day:
#   logs/all/<service>.<date>.log     every line, the full story of the day
#   logs/error/<service>.<date>.log   errors only, the short file you open when something breaks
# Finished days are gzipped into logs/archive/ and pruned after LOG_RETENTION_DAYS.
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# --- LiveKit Cloud (the phone line) ---
# Carries the live audio between the phone and the agent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Name the agent worker registers under. The API tells LiveKit to send each new room to it.
LIVEKIT_AGENT_NAME=duke
# How long a join token stays valid, in seconds. A call screen refreshes past this.
LIVEKIT_TOKEN_TTL=900

# --- A call ---
# How long a call may sit open with nobody talking before the friend says a short goodbye and
# hangs up, in seconds. Minutes are spent whether or not anyone speaks, so this is what stops a
# forgotten call from eating the month. The countdown only runs while the friend is waiting for an
# answer, and anyone speaking resets it. `0` turns it off.
CALL_IDLE_SECONDS=60

# --- STT: the ears (Deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- LLM: the brain (Groq) ---
# Free, and fast enough to feel like a real conversation. `openai/gpt-oss-20b` is the fastest
# model on the list, and this is a phone call, so it is the default. `openai/gpt-oss-120b` is
# the stronger one — better at nuance and long personas, about 350ms slower to speak — and is
# the one line to change if replies ever feel shallow. Both are reasoning models, and Duke asks
# them to think little (`reasoning_effort=low`), because at the default effort the reply is cut
# off mid-sentence or comes back empty.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional. Leave LLM_BASE_URL blank and the agent talks to Groq directly, exactly as before.
# Set it and the same OpenAI-shaped request goes to a local router first (9router-go, see
# docs/run-on-windows.md): the router holds the provider keys, forwards the turn, and can move to
# another provider when one refuses it. The model name then carries the router's provider prefix,
# and Duke still asks a reasoning model to think little, because `reasoningEffort` is read from the
# model name wherever `gpt-oss` appears in it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gq/openai/gpt-oss-20b

# --- TTS: the voice (Azure Speech, free F0 tier) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# The default voice, used when a friend has no voice of their own.
AZURE_VOICE=en-US-AriaNeural

# --- Data ---
# Supabase Postgres. Use the **Session pooler** line (port 5432) from Project -> Connect. The direct
# host is IPv6-only on new projects, and the transaction pooler (6543) wants prepare: false.
DATABASE_URL=postgresql://duke:duke@localhost:5432/duke
# Upstash Redis uses a rediss:// URL. A local Docker Redis uses redis://localhost:6379.
# This holds the per-call brief and the monthly usage counters.
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3001
# The browser origin allowed to call the API (CORS).
WEB_ORIGIN=http://localhost:3000

# --- Web ---
# The port the web app serves on when run on your own computer. Only scripts/run-local.ps1
# reads it; the Docker path uses the container's own port with Caddy in front.
WEB_PORT=3000
# Where the Next server forwards /api/* to. Read by the Next server, NOT sent to the browser,
# so it does not need the NEXT_PUBLIC_ prefix. In Docker set it to the API service,
# e.g. http://api:3001.
#
# This value is baked into the web build, so changing it means rebuilding the web app:
#     pnpm --filter @duke/web build
API_ORIGIN=http://127.0.0.1:3001

# --- The front door ---
# The lock on Duke, so that nobody who finds the address can spend your free minutes.
#
# AUTH_PASSWORD_HASH is a hash, never the password itself. Make one with:
#     node scripts/hash-password.mjs "your password"
# It has to be the hash and not the password: this value also signs session cookies, so keeping
# it unreadable means a copy of this file is not a way into the app.
#
# Until both of these are set, the API answers 503 and nobody gets in - which is the point.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# How long a phone stays signed in. 720 hours is thirty days.
# AUTH_SESSION_HOURS=720

# --- Deploy (only read by docker compose on the VPS, never by the app) ---
# The domain Caddy serves and gets a certificate for. It has to point at the VPS already.
# DOMAIN=duke.example.com
