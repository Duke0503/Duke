{
  "name": "@duke/agent",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "serve": "node --watch dist/main.js start",
    "start": "node dist/main.js start",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@duke/adapters": "workspace:*",
    "@duke/core": "workspace:*",
    "@duke/shared": "workspace:*",
    "@livekit/agents": "^1.9.2",
    "@livekit/agents-plugin-deepgram": "^1.9.2",
    "@livekit/agents-plugin-openai": "^1.9.2",
    "@livekit/agents-plugin-silero": "^1.9.2",
    "@livekit/rtc-node": "^1.1.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
