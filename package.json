{
  "name": "duke",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "doctor": "pnpm --filter @duke/shared build && node scripts/doctor.mjs",
    "db:push": "pnpm --filter @duke/shared build && pnpm --filter @duke/adapters db:push"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}

